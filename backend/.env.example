# PostgreSQL (Supabase / Neon): usa la connection string con sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/platea?schema=public&sslmode=require"

# Secreto para firmar JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"

# Cloudinary (free tier) — descomenta y rellena para habilitar /api/upload
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Servidor
PORT=3000
FRONTEND_URL="http://localhost:5173"
