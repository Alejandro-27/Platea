# ============================================================
# Platea — variables de entorno para desarrollo local
# Copia este archivo a backend/.env y ajusta los secretos.
# ============================================================

# PostgreSQL local (definido en docker-compose.yml)
DATABASE_URL=postgresql://platea_user:platea_pass@localhost:5432/platea_db

# Secreto JWT (mínimo 32 caracteres). Genera uno con: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_super_seguro_cambialo_en_produccion

# Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# API
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
